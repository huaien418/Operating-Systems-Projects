diff --git a/tempbuf/tempbuf.c b/tempbuf/tempbuf.c
new file mode 100644
index 000000000..4e3ec28e8
--- /dev/null
+++ b/tempbuf/tempbuf.c
@@ -0,0 +1,165 @@
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
+#include <linux/errno.h>
+
+struct temp_node {
+    struct list_head link;
+    char  *s;
+    size_t len;
+};
+
+static LIST_HEAD(temp_list);
+static DEFINE_MUTEX(temp_lock);
+
+enum tempbuf_mode {
+    PRINT_MODE  = 0,
+    ADD_MODE    = 1,
+    REMOVE_MODE = 2,
+};
+
+static struct temp_node *temp_find_locked(const char *key, size_t keylen)
+{
+    struct temp_node *it;
+
+    list_for_each_entry(it, &temp_list, link) {
+        if (it->len == keylen && !memcmp(it->s, key, keylen))
+            return it;
+    }
+    return NULL;
+}
+
+SYSCALL_DEFINE3(tempbuf, int, mode, void __user *, data, size_t, size)
+{
+    if (!data || size == 0)
+        return -EFAULT;
+
+    /* ADD */
+    if (mode == ADD_MODE) {
+        char *k = kmalloc(size + 1, GFP_KERNEL);
+        struct temp_node *node;
+
+        if (!k)
+            return -ENOMEM;
+
+        if (copy_from_user(k, data, size)) {
+            kfree(k);
+            return -EFAULT;
+        }
+        k[size] = '\0';
+
+        node = kzalloc(sizeof(*node), GFP_KERNEL);
+        if (!node) {
+            kfree(k);
+            return -ENOMEM;
+        }
+
+        node->s = k;
+        node->len = size;
+
+        mutex_lock(&temp_lock);
+        list_add_tail(&node->link, &temp_list);
+        mutex_unlock(&temp_lock);
+
+        pr_info("[tempbuf] Added: %s\n", k);
+        return 0;
+    }
+
+    /* REMOVE */
+    if (mode == REMOVE_MODE) {
+        char *k = kmalloc(size, GFP_KERNEL);
+        struct temp_node *hit;
+
+        if (!k)
+            return -ENOMEM;
+
+        if (copy_from_user(k, data, size)) {
+            kfree(k);
+            return -EFAULT;
+        }
+
+        mutex_lock(&temp_lock);
+        hit = temp_find_locked(k, size);
+        if (!hit) {
+            mutex_unlock(&temp_lock);
+            kfree(k);
+            return -ENOENT;
+        }
+        list_del(&hit->link);
+        mutex_unlock(&temp_lock);
+
+        pr_info("[tempbuf] Removed: %.*s\n", (int)size, k);
+
+        kfree(hit->s);
+        kfree(hit);
+        kfree(k);
+        return 0;
+    }
+
+    /* PRINT */
+    if (mode == PRINT_MODE) {
+        size_t total = 0;
+        struct temp_node *it;
+        char *out, *p;
+        bool first = true;
+        size_t copy_n;
+
+        /* 先算要輸出的總長度（含中間空白） */
+        mutex_lock(&temp_lock);
+        list_for_each_entry(it, &temp_list, link) {
+            if (total)
+                total++;        /* 空白 */
+            total += it->len;    /* 字串本身 */
+        }
+        mutex_unlock(&temp_lock);
+
+        if (total == 0) {
+            /* 空 list：user buffer 放空字串，dmesg 只印 [tempbuf] */
+            if (put_user('\0', (char __user *)data))
+                return -EFAULT;
+
+            pr_info("[tempbuf]\n");
+            return 0;   /* 實際寫入 0 個字元 */
+        }
+
+        out = kmalloc(total + 1, GFP_KERNEL);
+        if (!out)
+            return -ENOMEM;
+
+        p = out;
+        mutex_lock(&temp_lock);
+        list_for_each_entry(it, &temp_list, link) {
+            if (!first)
+                *p++ = ' ';
+            memcpy(p, it->s, it->len);
+            p += it->len;
+            first = false;
+        }
+        mutex_unlock(&temp_lock);
+        *p = '\0';
+
+        pr_info("[tempbuf] %s\n", out);
+
+        /* 寫回 user buffer，最多 size-1 個字元，最後補 '\0' */
+        copy_n = min(total, size - 1);
+
+        if (copy_to_user(data, out, copy_n)) {
+            kfree(out);
+            return -EFAULT;
+        }
+
+        if (put_user('\0', (char __user *)data + copy_n)) {
+            kfree(out);
+            return -EFAULT;
+        }
+
+        kfree(out);
+        return copy_n;   /* ✅ 依規格回傳實際寫入的字元數（不含 '\0'） */
+    }
+
+    return -EINVAL;
+}
