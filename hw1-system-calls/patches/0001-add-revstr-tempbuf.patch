diff --git a/revstr/revstr.c b/revstr/revstr.c
new file mode 100644
index 000000000..b9e9ae4e1
--- /dev/null
+++ b/revstr/revstr.c
@@ -0,0 +1,60 @@
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+
+/*
+ * sys_revstr(451)
+ * - Print "The origin string: <str>"
+ * - Reverse the string in kernel space
+ * - Print "The reversed string: <rev_str>"
+ * - Copy back to user
+ * - Return 0 on success
+ */
+SYSCALL_DEFINE2(revstr, char __user *, usr_str, size_t, n)
+{
+    char *k_str;
+    size_t i, j;
+
+    /* Basic arg check: pointer must be non-NULL, length > 0 */
+    if (!usr_str || n == 0)
+        return -EFAULT;
+
+    /* Allocate n+1 bytes for a C-string */
+    k_str = kmalloc(n + 1, GFP_KERNEL);
+    if (!k_str)
+        return -ENOMEM;
+
+    /* Copy from user space */
+    if (copy_from_user(k_str, usr_str, n)) {
+        kfree(k_str);
+        return -EFAULT;
+    }
+    k_str[n] = '\0';
+
+    /* Print original string */
+    pr_info("The origin string: %s\n", k_str);
+
+    /* In-place reverse using length n*/
+    i = 0;
+    j = n - 1;
+    while (i < j) {
+        char tmp = k_str[i];
+        k_str[i] = k_str[j];
+        k_str[j] = tmp;
+        i++;
+        j--;
+    }
+
+    /* Print reversed string */
+    pr_info("The reversed string: %s\n", k_str);
+
+    /* Copy reversed string back to user buffer */
+    if (copy_to_user(usr_str, k_str, n)) {
+        kfree(k_str);
+        return -EFAULT;
+    }
+
+    kfree(k_str); /*release memory*/
+    return 0;
+}
diff --git a/tempbuf/Makefile b/tempbuf/Makefile
new file mode 100644
index 000000000..c05984b33
--- /dev/null
+++ b/tempbuf/Makefile
@@ -0,0 +1 @@
